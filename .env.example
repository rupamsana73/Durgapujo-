# Puja AI - Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or .env to git.

# Required: Your OpenRouter API key (get it from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter model to use.
# Defaults to qwen/qwen3.8-27b:free (free, confirmed working).
# Examples:
#   qwen/qwen3.8-27b:free           (free, default - good Bengali support)
#   google/gemma-4-31b-it:free      (free, may hit rate limits)
#   openai/gpt-4o-mini              (paid, highest quality)
# Leave blank or omit to use the built-in default.
OPENROUTER_MODEL=

# Optional: Fallback model used when the primary is rate-limited (429).
# After MAX_RETRIES on the primary model are exhausted, this model is tried once.
# Leave blank to disable the fallback (a friendly error is returned instead).
OPENROUTER_FALLBACK_MODEL=