# Puja AI - Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or .env to git.

# Required: Your OpenRouter API key (get it from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter model to use.
# Defaults to openrouter/free (official free-model router, zero cost).
# Examples:
#   openrouter/free                  (free, default - auto-selects a free model)
#   openrouter/auto                  (paid, auto-selects best model for the task)
#   openai/gpt-6-luna                (paid, fast and cost-efficient)
# Leave blank or omit to use the built-in default.
OPENROUTER_MODEL=

# Optional: Fallback model used when the primary fails (404 or 429).
# After MAX_RETRIES on the primary model are exhausted, this model is tried once.
# Leave blank to disable the fallback (a friendly error is returned instead).
OPENROUTER_FALLBACK_MODEL=